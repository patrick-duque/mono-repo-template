{
  "name": "white-label-starter",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "apps/web-app",
    "apps/api-service",
    "apps/mobile-app",
    "packages/shared"
  ],
  "homepage": "https://github.com/white-label-starter/white-label-starter#readme",
  "bugs": {
    "url": "https://github.com/white-label-starter/white-label-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/white-label-starter/white-label-starter.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev:web-app": "npm --workspace @white-label/web-app run start:dev",
    "dev:api-service": "npm --workspace @white-label/api-service run start:dev",
    "dev:mobile-app": "npm --workspace @white-label/mobile-app run start",
    "build": "npm run build:web-app && npm run build:api-service",
    "build:web-app": "npm --workspace @white-label/web-app run build",
    "build:api-service": "npm --workspace @white-label/api-service run build",
    "lint": "npm run lint:web-app && npm run lint:api-service && npm run lint:mobile-app",
    "lint:web-app": "npm --workspace @white-label/web-app run lint",
    "lint:api-service": "npm --workspace @white-label/api-service run lint",
    "lint:mobile-app": "npm --workspace @white-label/mobile-app run lint && npm --workspace @white-label/mobile-app run typecheck",
    "test": "npm --workspaces --if-present run test",
    "pre-commit": "npm run lint && npm run build && npm run test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "db:diff": "supabase db diff -f dbDiff",
    "db:reset": "supabase db reset",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
